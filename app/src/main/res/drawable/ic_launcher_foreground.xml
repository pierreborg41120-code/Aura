<?xml version="1.0" encoding="utf-8"?>
<!--
  Premier plan : une éclipse annulaire. Un disque sombre, à peine décalé vers le haut à gauche,
  laisse dépasser un anneau de lumière plus épais en bas à droite, entouré d'une lueur lavande.
  Tout tient dans la zone de sécurité (cercle de 33 de rayon autour du centre).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Lueur diffuse autour de l'anneau. -->
    <path android:pathData="M14,54a40,40 0,1 1,80,0a40,40 0,1 1,-80,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="56"
                android:centerY="56"
                android:gradientRadius="40">
                <item android:offset="0.45" android:color="#8C8C9BFF" />
                <item android:offset="0.62" android:color="#2E8C9BFF" />
                <item android:offset="1" android:color="#008C9BFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Disque sombre (l'astre qui masque la lumière). -->
    <path
        android:fillColor="#FF0B0B12"
        android:pathData="M33.5,52.1a18.6,18.6 0,1 1,37.2,0a18.6,18.6 0,1 1,-37.2,0z" />
    <!-- Anneau de lumière : grand cercle moins le disque décalé. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M31,54a23,23 0,1 1,46,0a23,23 0,1 1,-46,0zM33.5,52.1a18.6,18.6 0,1 1,37.2,0a18.6,18.6 0,1 1,-37.2,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="36"
                android:endX="72"
                android:endY="72">
                <item android:offset="0" android:color="#FF8C9BFF" />
                <item android:offset="0.7" android:color="#FFDDE2FF" />
                <item android:offset="1" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
